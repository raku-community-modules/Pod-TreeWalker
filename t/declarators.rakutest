use Test;
use Pod::TreeWalker;
use lib $*PROGRAM.sibling('lib');
use TestListener;

plan 1;

my $pod_i = 0;

#| before class
class Foo {
    has $.foo; #= a foo!
}

subtest {
    my $l = TestListener.new;
    Pod::TreeWalker.new(:listener($l)).walk-pod($=pod[$pod_i++]);

    my @expect = (
         { :start, :type('declarator'), :wherefore(Foo) },
         { :text('before class') },
         { :end, :type('declarator'), :wherefore(Foo) },
    );

    is-deeply $l.events, @expect, 'got expected events for class declarator';

    # The legacy compiler frontend only sets an attribute's WHEREFORE
    # once .WHY has been called on the attribute.
    my $foo-attr = Foo.^attributes.first(*.name eq '$!foo');
    $foo-attr.WHY;

    $l = TestListener.new;
    Pod::TreeWalker.new(:listener($l)).walk-pod($=pod[$pod_i++]);

    @expect = (
         { :start, :type('declarator'), :wherefore($foo-attr) },
         { :text('a foo!') },
         { :end, :type('declarator'), :wherefore($foo-attr) },
    );

    is-deeply $l.events, @expect, 'got expected events for attribute declarator';
}, 'declarators';

# vim: expandtab shiftwidth=4
